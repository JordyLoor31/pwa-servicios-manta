DB_HOST=localhost
DB_PORT=5432
DB_USER=servicios_manta
DB_PASS=tu_password_seguro
DB_NAME=servicios_manta
# URL completa del PostgreSQL (usada en deploy como Render); si está definida, se usa con SSL en vez de DB_*
DATABASE_URL=

JWT_SECRET=genera_uno_con_openssl_rand_-hex_48
JWT_EXPIRES_IN=24h

CORS_ORIGINS=https://tu-dominio-frontend.com

# Google Sign-In (OAuth 2.0 Client ID, formato xxxx.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=
# API key de Google (no se usa para verificar login; solo servicios Google adicionales)
GOOGLE_API_KEY=

# Recuperación de contraseña (Resend API por HTTPS)
# URL pública del frontend (se usa para construir el enlace de reset)
FRONTEND_URL=http://localhost:5173
# API key de https://resend.com (formato re_xxx). Obligatoria para enviar correos.
RESEND_API_KEY=
# Remitente: debe ser un dominio verificado en Resend (p. ej. "CamelloApp <no-reply@micamelloapp.com>")
RESEND_FROM=CamelloApp <onboarding@resend.dev>