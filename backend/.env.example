DB_HOST=localhost
DB_PORT=5432
DB_USER=servicios_manta
DB_PASS=tu_password_seguro
DB_NAME=servicios_manta
# URL completa del PostgreSQL (usada en deploy como Render); si está definida, se usa con SSL en vez de DB_*
DATABASE_URL=

JWT_SECRET=genera_uno_con_openssl_rand_-hex_48
JWT_EXPIRES_IN=24h

CORS_ORIGINS=https://tu-dominio-frontend.com

# Google Sign-In (OAuth 2.0 Client ID, formato xxxx.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=
# API key de Google (no se usa para verificar login; solo servicios Google adicionales)
GOOGLE_API_KEY=

# Recuperación de contraseña (envío vía Gmail API por HTTPS)
# URL pública del frontend (se usa para construir el enlace de reset)
FRONTEND_URL=http://localhost:5173
# Cliente OAuth usado SOLO para Gmail API (puede ser distinto del cliente del login Google)
GMAIL_CLIENT_ID=
# Secret del cliente OAuth de Gmail (Google Cloud Console -> Credenciales)
GOOGLE_CLIENT_SECRET=
# Cuenta Gmail desde la que se envía (el dueño de la cuenta aprueba el consentimiento una vez)
GMAIL_USER=micamelloapp@gmail.com
# Nombre visible del remitente
GMAIL_SENDER_NAME=CamelloApp
# Refresh token obtenido con /mail/gmail/auth-url + /mail/gmail/callback
GMAIL_REFRESH_TOKEN=
# Redirect URI registrada en el cliente OAuth (debe coincidir con la de Google Cloud)
GMAIL_REDIRECT_URI=http://localhost:3000/mail/gmail/callback