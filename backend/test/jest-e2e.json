{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "ESNext",
          "moduleResolution": "Bundler",
          "rootDir": ".",
          "emitDecoratorMetadata": true
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^@nestjs/throttler$": "<rootDir>/support/throttler.ts",
    "^\\.\\./services/usuarios\\.service$": "<rootDir>/support/usuarios.service.ts",
    "^\\.\\./\\.\\./usuarios/services/usuarios\\.service$": "<rootDir>/support/usuarios.service.ts",
    "^\\.\\./services/solicitudes\\.service$": "<rootDir>/support/solicitudes.service.ts"
  },
  "extensionsToTreatAsEsm": [".ts"]
}
